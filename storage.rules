rules_version = '2';
// Production rules (also enforced by the local Storage emulator).
// Applicants may upload only into their own resumes/<uid>/… and images/<uid>/…
// paths, capped at 10 MB. Reads are off — staff view files via the tokenized
// download URL stored on the application, which does not need a read rule.
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{uid}/{file=**} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && folder in ['resumes', 'images']
                   && request.resource.size < 10 * 1024 * 1024;
      allow read: if false;
    }
  }
}
